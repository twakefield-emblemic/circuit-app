# Circuit — personal CoCreate LA companion, standalone backend
# Copy to .env and fill in before running locally or deploying.

PORT=3000

# Render Postgres (or any Postgres) connection string.
DATABASE_URL=postgres://user:password@host:5432/circuit

# Reuse the same key emblemic-backend already uses — no new billing setup needed.
# Needs access to a vision-capable model with the web_search tool.
ANTHROPIC_API_KEY=

# A shared secret the frontend sends on every request, so the API isn't open
# to the whole internet. Render's blueprint (render.yaml) auto-generates this
# in production — only set it by hand for local dev.
APP_SHARED_SECRET=change-me

# The workspace slug the plain root URL (no /w/<slug>) resolves to — this is
# your own personal link. Defaults to "main" if unset; only change this if
# you want your own link to use a different word.
OWNER_WORKSPACE=main
